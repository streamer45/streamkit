# Oneshot pipeline: render a web page to a short MP4 clip.
# Placeholders are substituted by renderClipPipeline (see pipelines.go); the
# encoder node is injected per selected profile (see encoders.go).
# mp4 mode:stream = fragmented/progressive, so it plays inline as it renders.
name: web-clip
description: Render a web page to a short MP4 clip
mode: oneshot
attributes:
  service: web-capture
  mode: clip
client:
  input:
    type: none
  output:
    type: video
nodes:
  web:
    kind: plugin::native::servo
    params:
      url: {{URL}}
      width: {{WIDTH}}
      height: {{HEIGHT}}
      fps: {{FPS}}
      frame_count: {{FRAME_COUNT}}
      load_timeout_secs: {{LOAD_TIMEOUT}}
  pixel_convert:
    kind: video::pixel_convert
    params:
      output_format: nv12
    needs: web
{{ENCODER_BLOCK}}
  muxer:
    kind: containers::mp4::muxer
    params:
      mode: stream
      video_width: {{WIDTH}}
      video_height: {{HEIGHT}}
      video_codec: {{MUX_CODEC}}
    needs: encoder
  http_output:
    kind: streamkit::http_output
    params:
      content_type: {{CONTENT_TYPE}}
    needs: muxer
