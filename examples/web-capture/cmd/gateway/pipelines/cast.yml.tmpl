# Dynamic pipeline: render a web page to a live WebM stream over HTTP MSE.
# Placeholders are substituted by renderCastPipeline (see pipelines.go); the
# encoder and muxer nodes are injected per selected profile (WebM for VP9/AV1,
# fMP4 for H.264 — see encoders.go). The stream is unbounded (no frame limit).
name: web-cast
description: Render a web page to a live WebM stream
mode: dynamic
attributes:
  service: web-capture
  mode: cast
client:
  watch:
    mse_path: /video
    video: true
nodes:
  web:
    kind: plugin::native::servo
    params:
      url: {{URL}}
      width: {{WIDTH}}
      height: {{HEIGHT}}
      fps: {{FPS}}
      load_timeout_secs: {{LOAD_TIMEOUT}}
  pixel_convert:
    kind: video::pixel_convert
    params:
      output_format: nv12
    needs: web
{{ENCODER_BLOCK}}
{{MUXER_BLOCK}}
  http_mse:
    kind: transport::http::mse
    params:
      path: /video
      max_clients: {{MAX_CLIENTS}}
      content_type: {{CONTENT_TYPE}}
    needs: muxer
