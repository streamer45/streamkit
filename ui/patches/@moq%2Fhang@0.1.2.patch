diff --git a/publish/video/encoder.js b/publish/video/encoder.js
--- a/publish/video/encoder.js
+++ b/publish/video/encoder.js
@@ -49,8 +49,26 @@
                     producer.close(err);
                 },
             });
-            effect.cleanup(() => encoder.close());
-            effect.effect(() => {
+            // PATCH(streamkit): guard against double-close — the VideoEncoder may have
+            // already transitioned to "closed" via its own error callback (producer.close
+            // above), in which case calling close() again throws InvalidStateError.
+            effect.cleanup(() => {
+                if (encoder.state !== "closed")
+                    encoder.close();
+            });
+            // PATCH(streamkit): upstream bug — the original callback was `() => {...}`
+            // without an `(effect)` parameter, so `effect.get(this.#config)` below
+            // resolved `effect` to the *outer* closure variable (the serve() parameter,
+            // i.e. the request-handling effect from broadcast.js). This subscribed the
+            // *parent* effect to #config, so when camera.source flapped during the
+            // permission-grant → device-enumeration cascade and #config transiently
+            // went undefined, the parent re-ran — tearing down the producer (closing
+            // the MoQ track, seen as "subscribe cancelled" on the server) and the
+            // encoder. Accepting the child effect here means only this 3-line child
+            // re-runs on #config changes; the producer/encoder/track all survive.
+            // Tracked for upstream: https://github.com/moq-dev/moq (same bug exists
+            // in @moq/publish@0.2.2).
+            effect.effect((effect) => {
                 const config = effect.get(this.#config);
                 if (!config)
                     return;
@@ -163,7 +181,11 @@
                 // @ts-expect-error Typescript needs to be updated.
                 hevc: codec.startsWith("hev1") ? { format: "annexb" } : undefined,
                 latencyMode: "realtime",
-                hardwareAcceleration: "prefer-hardware",
+                // PATCH(streamkit): use "no-preference" instead of "prefer-hardware"
+                // because isConfigSupported can return false positives for hardware
+                // encoding on Linux (VA-API/GPU driver issues), causing configure()
+                // to throw "Encoder creation error".
+                hardwareAcceleration: "no-preference",
             };
             effect.set(this.#config, config);
         });
