    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "knip": "^5.87.0",
    "prettier": "^3.8.1",
