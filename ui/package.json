    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
