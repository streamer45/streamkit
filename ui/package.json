{
  "name": "ui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "prettier --check src && eslint src --ext .ts,.tsx && tsc --noEmit",
    "knip": "knip",
    "lint:fix": "prettier --write src && eslint src --fix --ext .ts,.tsx && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:perf": "UPDATE_PERF_BASELINE=1 vitest run --reporter=verbose perf.test",
    "prepare": "cd .. && husky .husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
