{
  "name": "ui",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "lint": "prettier --check src && eslint src --ext .ts,.tsx && tsc --noEmit",
    "knip": "knip",
    "verify-compiler": "bun scripts/verify-react-compiler.mjs",
    "doctor": "react-doctor --diff origin/main -y --no-score --no-telemetry --no-dead-code --blocking error",
    "lint:fix": "prettier --write src && eslint src --fix --ext .ts,.tsx && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:perf": "UPDATE_PERF_BASELINE=1 vitest run --reporter=verbose perf.test",
    "prepare": "cd .. && husky .husky"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.5.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-complexity": "^1.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.20.0",
    "prettier": "^3.8.4",
    "react-doctor": "0.5.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@moq/hang": "^0.2.11",
    "@moq/publish": "^0.2.15",
    "@moq/signals": "^0.1.9",
    "@moq/watch": "^0.2.17",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.1",
    "@types/js-yaml": "^4.0.9",
    "@uiw/codemirror-theme-solarized": "^4.25.10",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.1",
    "codemirror": "6.65.7",
    "jotai": "^2.20.1",
    "jotai-family": "^1.0.2",
    "js-yaml": "^4.2.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.18.0",
    "tslog": "^4.10.2",
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@codemirror/view": "$@codemirror/view"
  }
}
